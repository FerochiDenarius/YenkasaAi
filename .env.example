# Application
APP_NAME=YenkasaAI Cloud Backend
APP_ENV=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:5174

# Local RAG runtime and model providers
VERTEX_AI_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
VERTEX_AI_TEMPERATURE=0.2
GEMINI_REASONING_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-005
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_K=5
MAX_HISTORY_TURNS=6
CHROMA_COLLECTION_NAME=yenkasa_research
CHROMA_PUBLIC_COLLECTION_NAME=yenkasa_platform_knowledge
LOCAL_WORKDIR=/var/lib/yenkasa-ai
PUBLIC_KNOWLEDGE_BOOTSTRAP_DIR=/workspace/knowledge/semantic/public

# Google Application Default Credentials for Vertex AI.
# Mount the file into the container and point this path at it when running locally.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-service-account.json

# Optional Google Cloud Storage snapshot persistence; leave empty to use the volume only.
GCS_BUCKET=
GCS_CHROMA_PREFIX=yenkasa-ai/chroma
GCS_KNOWLEDGE_PREFIX=yenkasa-ai/knowledge

# Intelligence services
DEV_INTELLIGENCE_ENABLED=true
MONGO_ROOT_USERNAME=yenkasa
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
MONGODB_URI=mongodb://yenkasa:replace-with-a-long-random-password@mongo:27017/?authSource=admin
MONGODB_DATABASE=yenkasa_ai
MONGODB_OPERATIONAL_DATABASE=yenkasaChat
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_CHUNKS_COLLECTION=repo_chunks
MONGODB_JOBS_COLLECTION=repo_ingestion_jobs
MONGODB_INSIGHTS_COLLECTION=repo_insights
MONGODB_EVENTS_COLLECTION=events
MONGODB_USERS_COLLECTION=users
MONGODB_SESSIONS_COLLECTION=sessions
MONGODB_YME_COLLECTION=yme_events
MONGODB_CONVERSATIONS_COLLECTION=ai_conversations
MONGODB_SECURITY_ALERTS_COLLECTION=security_alerts
MONGODB_VECTOR_INDEX_NAME=repo_chunks_vector_index
MONGODB_VECTOR_DIMENSIONS=768

# Redis / repository ingestion
REDIS_URL=redis://redis:6379/0
REPO_INGESTION_QUEUE_NAME=repo-ingestion
REPO_INGESTION_JOB_TIMEOUT_S=3600
REPO_ALLOWED_ROOTS=/workspace,/tmp
REPO_CHUNK_MAX_LINES=90
REPO_CHUNK_OVERLAP_LINES=15
REPO_FILE_SIZE_LIMIT_BYTES=1048576
REPO_INSIGHT_LARGE_FILE_LINES=1200
REPO_SEARCH_TOP_K=6
REPO_SEARCH_NUM_CANDIDATES=120
EMBEDDING_BATCH_SIZE=12
EMBEDDING_RETRY_ATTEMPTS=3

# Authentication and rate limiting
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
AUTH_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_LIMIT=12
AUTH_REGISTER_RATE_LIMIT=5
AI_REQUEST_RATE_LIMIT=120
MAX_CONCURRENT_SESSIONS=5
